{
  "name": "bga.tapestry",
  "version": "1.0.0",
  "description": "",
  "main": "tapestry.js",
  "scripts": {
    "build": "npm run genmat",
    "tests": "APP_GAMEMODULE_PATH=~/git/bga-sharedcode/misc/ phpunit --display-deprecations --display-warnings --colors=always",
    "tests:cov": "XDEBUG_MODE=coverage APP_GAMEMODULE_PATH=~/git/bga-sharedcode/misc/ phpunit --coverage-text",
    "lint:php": "find modules/ tests/ -name '*.php' -exec php8.4 -l {} + && echo 'All PHP files OK'",
    "lint:phpstan": "phpstan analyse -c misc/phpstan.neon",
    "predeploy": "npm run lint:php && npm run tests",
    "genmat": "php8.4 ~/git/bga-sharedcode/misc/genmat.php misc/benefit_types.csv && prettier --write material.inc.php",
    "end": "echo The End"
  },
  "author": "VictoriaLa",
  "license": "EPL2.0",
  "devDependencies": {
    "@prettier/plugin-php": "^0.22",
    "@types/chai": "^4.x.x",
    "@types/mocha": "^10.0.10",
    "@types/node": "^10.9.2",
    "@types/sinon": "^10.x.x",
    "chai": "^4.x.x",
    "jsdom": "^20.0.0",
    "mocha": "^10.x.x",
    "prettier": "^3.6",
    "sass": "^1.32.6",
    "sinon": "^15.x.x",
    "ts-node": "^10.9.2",
    "typescript": "^4.9.5"
  },
  "prettier": {
    "plugins": [
      "@prettier/plugin-php"
    ],
    "braceStyle": "1tbs",
    "printWidth": 140,
    "trailingComma": "none"
  }
}
