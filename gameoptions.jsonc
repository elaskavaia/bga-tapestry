{
  // option ids should be between 100 and 199
  // See https://en.doc.boardgamearena.com/Options_and_preferences:_gameoptions.json,_gamepreferences.json for more details
  "100": {
    "name": "Civilization Adjustments",
    "values": {
      "2": {
        "name": "no Adjustments (Deprecated)",
        "description": "original rules (Deprecated EOL 2027)"
      },
      "1": {
        "name": "with Adjustments (Deprecated)",
        "description": "latest official adjustments (Deprecated EOL 2027)"
      },
      "4": {
        "name": "with Experimental Adjustments Nov 2022 (Removed)",
        "beta": true,
        "description": "experimental rules (Removed, left only for existing games)"
      },
      "8": {
        "name": "Adjustment Civilization Pack (Default)",
        "description": "official expansion"
      },
      "9": {
        "name": "Adjustment Civilization Pack + new Alchemists (Testing)",
        "beta": true,
        "description": "official expansion, with the reworked Alchemists (testing, rules may change)"
      }
    },
    // maintenance switch, disables table creation for every value:
    // "startcondition": {
    //   "1": [{ "type": "minplayers", "value": 32, "message": "Maintenance in progress.  Table creation for Tapestry is disabled." }],
    //   "2": [{ "type": "minplayers", "value": 32, "message": "Maintenance in progress.  Table creation for Tapestry is disabled." }],
    //   "4": [{ "type": "minplayers", "value": 32, "message": "Maintenance in progress.  Table creation for Tapestry is disabled." }]
    // },
    "startcondition": {
      "4": [
        {
          "type": "minplayers",
          "value": 32,
          "message": "This option can no longer be used (remains for backward compatibility), use Adjustment Civilization Pack"
        }
      ]
    },
    "default": 8
  },
  // 101 and 102: card removal is mapped in material.inc.php ($this->option_removals)
  "101": {
    "name": "Tapestry: Marriage of State",
    "values": {
      "0": {
        "name": "Keep",
        "description": "original rules"
      },
      "1": {
        "name": "Remove",
        "tmdisplay": "without Marriage of State",
        "description": "house rules"
      }
    },
    "default": 0
  },
  "102": {
    "name": "Tapestry: Renaissance",
    "values": {
      "0": {
        "name": "Keep",
        "description": "original rules"
      },
      "1": {
        "name": "Remove",
        "tmdisplay": "without Renaissance",
        "description": "house rules"
      }
    },
    "default": 0
  },
  "140": {
    "name": "Civilization Set",
    // bit flags: 0b001 original, 0b010 Plans & Ploys, 0b100 Arts & Architecture
    "values": {
      "7": {
        "name": "All (Original + PP + AA)",
        "tmdisplay": "Civilation Set: All"
      },
      "1": {
        "name": "Original Only"
      },
      "3": {
        "name": "Original + Plans & Ploys",
        "tmdisplay": "Plans & Ploys"
      }
      // "5": { "name": "Original + Arts & Architecture" },
      // "2": {
      //   "name": "Plans & Ploys Only - Do not use",
      //   "tmdisplay": "Plans & Ploys",
      //   "beta": true
      // },
      // "6": {
      //   "name": "Only Expansions (PP + AA) - For Testing",
      //   "tmdisplay": "Civilation Set: Only Expansions",
      //   "beta": true
      // }
    },
    "default": 1,
    "displaycondition": [
      {
        "type": "otheroptionisnot",
        "id": 100,
        "value": 4
      }
    ],
    "notdisplayedmessage": "Original Only - Civilization Set selection is not available with Experimental Adjustments"
  },
  "151": {
    "name": "Automa Level",
    "values": {
